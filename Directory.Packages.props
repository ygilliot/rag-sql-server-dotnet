<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Data access: SqlVector<float> and SqlDbTypeExtensions.Vector need 6.1.0 or later. -->
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <!-- AI abstractions and Microsoft Agent Framework. -->
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.10.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.10.1" />
    <PackageVersion Include="Microsoft.Agents.AI" Version="1.23.0" />
    <PackageVersion Include="Microsoft.Agents.AI.OpenAI" Version="1.23.0" />
    <PackageVersion Include="OpenAI" Version="2.14.0" />
    <PackageVersion Include="Azure.AI.OpenAI" Version="2.9.0-beta.1" />
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <!-- Only for the "before" half of the Semantic Kernel migration snippets. -->
    <PackageVersion Include="Microsoft.SemanticKernel" Version="1.80.1" />
    <PackageVersion Include="Microsoft.SemanticKernel.Agents.Core" Version="1.80.1" />
    <!-- Tests. -->
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>
</Project>
